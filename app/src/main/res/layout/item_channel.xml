<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:focusable="true"
    android:clickable="true"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:background="@drawable/selector_item_focus">

    <!-- Channel Number or Playing Wave Badge (Overlay matching DIYP original) -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="28dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="6dp">

        <TextView
            android:id="@+id/tv_channel_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="28dp"
            android:gravity="center"
            android:layout_gravity="center"
            android:textSize="13sp"
            android:textColor="@color/text_white"
            android:background="@drawable/bg_channel_num" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_playing"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:visibility="gone"
            app:lottie_fileName="iv_playing.json"
            app:lottie_loop="true"
            app:lottie_autoPlay="false" />
    </FrameLayout>

    <!-- Channel Logo -->
    <ImageView
        android:id="@+id/iv_channel_logo"
        android:layout_width="48dp"
        android:layout_height="30dp"
        android:scaleType="fitCenter"
        android:layout_marginEnd="6dp"
        android:visibility="visible" />

    <!-- Names & EPG Summary -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.diyp.next.ui.view.ScrollTextView
            android:id="@+id/tv_channel_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_white" />

        <TextView
            android:id="@+id/tv_channel_epg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#ffacaba7"
            android:singleLine="true"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>
