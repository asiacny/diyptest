<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_channel_menu"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:visibility="gone">

    <!-- Folded Category Column: "全部频道" strip (hidden by default, shown when collapsed) -->
    <LinearLayout
        android:id="@+id/layout_category_collapsed"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/bg_panel_dark"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="全"
            android:textSize="13sp"
            android:textColor="@color/text_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="部"
            android:textSize="13sp"
            android:textColor="@color/text_white"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="频"
            android:textSize="13sp"
            android:textColor="@color/text_white"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="道"
            android:textSize="13sp"
            android:textColor="@color/text_white"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Column 1: Category Groups (width narrowed to 105dp, matching old) -->
    <LinearLayout
        android:id="@+id/layout_category_column"
        android:layout_width="105dp"
        android:layout_height="match_parent"
        android:background="@color/bg_panel_dark"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_categories"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none" />

    </LinearLayout>

    <!-- Column 2: Channel List (width 260dp, removed top category title and divider!) -->
    <LinearLayout
        android:id="@+id/layout_channel_column"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:background="@color/bg_panel_light"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_channels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none" />

    </LinearLayout>

    <!-- Action Strip: Right-side vertical strip ("时移回放" or "节目单") -->
    <LinearLayout
        android:id="@+id/layout_catchup_strip"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/bg_panel_dark"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tv_catchup_strip_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="节目单"
            android:textSize="13sp"
            android:textColor="@color/text_white" />
    </LinearLayout>

    <!-- Column 3: Multi-day EPG Schedule Container (hidden by default) -->
    <LinearLayout
        android:id="@+id/layout_epg_column"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- Date selector column (width 56dp) -->
        <LinearLayout
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:background="@color/bg_panel_dark"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_epg_dates"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- EPG Program List Column (width 270dp) -->
        <FrameLayout
            android:layout_width="270dp"
            android:layout_height="match_parent"
            android:background="@color/bg_panel_epg">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_epg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/tv_epg_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/no_epg_info"
                android:textSize="15sp"
                android:textColor="@color/text_gray"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
